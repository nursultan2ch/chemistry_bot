# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Local development (docker compose sets this itself)
DATABASE_URL=postgresql://localhost/chemistry_bot

# Used by docker compose for the bundled PostgreSQL
POSTGRES_PASSWORD=change-me

# Admin panel login (required; the panel refuses to start without them)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PORT=5001
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32

FLASK_DEBUG=false
